#!/bin/sh
# Generated by rails_quality_assurance. Run local quality checks before committing.
# Bypass with: git commit --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

fail() {
  printf '\n\033[0;31mCannot commit: %s\033[0m\n' "$1"
  if [ -n "${2:-}" ]; then
    printf '\n%s\n' "$2"
  fi
  printf '\nTo bypass this check (not recommended):\n  git commit --no-verify\n'
  exit 1
}

if [ -n "$(staged '*.rb' '*.rake' '*.gemspec' 'Gemfile' 'Rakefile' 'config.ru' '.rubocop.yml' '.reek.yml')" ]; then
  echo 'Checking RuboCop...'
  if ! bundle exec rubocop; then
    fail 'RuboCop offenses detected' 'Fix the offenses before committing, or run: bundle exec rubocop -A'
  fi
<%- if @reek_command -%>

  echo 'Checking Reek...'
  if ! <%= @reek_command %>; then
    fail 'Reek code smells detected' 'Fix the code smells before committing.'
  fi
<%- end -%>
fi

if [ -n "$(staged 'spec/**/*_spec.rb' 'spec/**/*.rb')" ]; then
  echo 'Checking RSpec...'
  if ! bundle exec rspec --fail-fast; then
    fail 'RSpec failures detected' 'Fix the failing specs before committing.'
  fi
fi

echo 'All pre-commit checks passed'
