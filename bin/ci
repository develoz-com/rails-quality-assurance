#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'English'

def run_step(name, command)
  puts
  puts '=' * 60
  puts "Running: #{name}"
  puts '=' * 60

  system(command)
  exit_code = $CHILD_STATUS.exitstatus

  if exit_code.zero?
    puts "✓ #{name} passed"
  else
    puts "✗ #{name} failed (exit code: #{exit_code})"
    exit exit_code
  end
end

puts
puts '=' * 60
puts 'rails-quality-assurance CI Pipeline'
puts '=' * 60

run_step('RuboCop', 'bundle exec rubocop')
run_step('Reek', 'bundle exec reek --config .reek.yml lib')
run_step('RSpec', 'bundle exec rspec')
run_step('Gem build', 'gem build rails-quality-assurance.gemspec')

puts
puts '=' * 60
puts '✓ All CI checks passed'
puts '=' * 60
